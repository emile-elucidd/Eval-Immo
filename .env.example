# ─────────────────────────────────────────────────────────────────────────────
# Domaine
# ─────────────────────────────────────────────────────────────────────────────
# Le domaine racine, une fois acheté. Chaque agence est un sous-domaine :
# rive-ouest.estimation-immo.fr/boulogne-billancourt
# Non défini : le sous-domaine est deviné (2 derniers labels = domaine racine),
# ce qui marche pour exemple.fr mais pas pour exemple.co.uk.
NEXT_PUBLIC_ROOT_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Page générique (l'apex : exemple.fr, sans sous-domaine ni ville)
# ─────────────────────────────────────────────────────────────────────────────
# « Estimation immobilière dans votre commune » : une vraie landing de capture,
# et la destination de tout lien cassé. Ses leads n'ont pas d'agence : ils
# partent vers LEADS_WEBHOOK_URL.

# Nom affiché dans le header, le footer et le tunnel. Défaut : « Estimation Immobilière ».
NEXT_PUBLIC_SITE_NAME=
# Photo de couverture générique — sans skyline reconnaissable. Défaut : /hero-cover.jpg
NEXT_PUBLIC_GENERIC_COVER=
# Coordonnées de l'éditeur du site (les vôtres, pas celles d'un client).
NEXT_PUBLIC_SITE_PHONE=
NEXT_PUBLIC_SITE_EMAIL=
NEXT_PUBLIC_SITE_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Registre des agences clientes
# ─────────────────────────────────────────────────────────────────────────────
# "local" (défaut) : src/lib/tenant/agencies.ts, versionné, redéploiement à chaque ajout.
# "http"           : JSON distant — un CMS, ou un export des sous-comptes Go High Level.
TENANT_SOURCE=

# URL du registre JSON quand TENANT_SOURCE=http. Renvoie soit [ {...} ], soit { "agencies": [ {...} ] }.
# En cas d'échec, repli automatique sur le fichier local.
TENANT_SOURCE_URL=
TENANT_SOURCE_TOKEN=
# Secondes avant relecture du registre distant (défaut : 300).
TENANT_SOURCE_TTL=

# ─────────────────────────────────────────────────────────────────────────────
# Go High Level
# ─────────────────────────────────────────────────────────────────────────────
# Token d'une Private Integration GHL, par défaut pour tous les sous-comptes.
# Un client peut le surcharger avec AGENCY_<SLUG>_GHL_TOKEN.
GHL_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Par client — nommées d'après le slug de l'agence, rien à écrire dans le code.
#   slug "rive-ouest"  →  AGENCY_RIVE_OUEST_…
#   slug "havre-immo"  →  AGENCY_HAVRE_IMMO_…
# Ajouter un client = ajouter son entrée dans le registre + ces 3 variables.
# ─────────────────────────────────────────────────────────────────────────────

# Sous-compte GHL qui reçoit les leads de ce client (Settings → Business Profile).
AGENCY_RIVE_OUEST_GHL_LOCATION_ID=
# Calendrier embarqué sur /rendez-vous (Calendars → … → Embed code, l'URL de l'iframe).
AGENCY_RIVE_OUEST_CALENDAR_URL=
# Optionnel : webhook entrant GHL/Make/Zapier, en plus ou à la place de l'API.
AGENCY_RIVE_OUEST_WEBHOOK_URL=

AGENCY_HAVRE_IMMO_GHL_LOCATION_ID=
AGENCY_HAVRE_IMMO_CALENDAR_URL=
AGENCY_HAVRE_IMMO_WEBHOOK_URL=

# Destination de repli, pour les agences qui n'ont déclaré ni webhook ni GHL.
# Non défini : le lead est loggé et écrit dans .leads/leads.jsonl (dev uniquement).
LEADS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Carte
# ─────────────────────────────────────────────────────────────────────────────
# Carte affichée à l'étape « Validez l'adresse ».
# Non définie : repli sur OpenStreetMap (fonctionne sans compte).
# Définie : Google Maps Embed API — activer « Maps Embed API » sur la clé.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
